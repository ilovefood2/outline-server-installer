+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"sync"
+
+	"github.com/Jigsaw-Code/outline-sdk/transport"
+	onet "github.com/Jigsaw-Code/outline-ss-server/net"
+)
+
+type routerKeyGrant struct {
+	fingerprint [32]byte
+	lan         bool
+}
+
+type routerKeyStream struct {
+	id    string
+	close func()
+}
+
+type routerAccessPolicy struct {
+	mu           sync.Mutex
+	keys         map[string]routerKeyGrant
+	streams      map[*routerKeyStream]bool
+	allowPrivate bool
+}
+
+type routerKeyView struct {
+	policy *routerAccessPolicy
+	keys   map[string]routerKeyGrant
+}
+
+func routerGrants(keys []KeyConfig) map[string]routerKeyGrant {
+	grants := make(map[string]routerKeyGrant, len(keys))
+	for _, key := range keys {
+		grants[key.ID] = routerKeyGrant{sha256.Sum256([]byte(key.Cipher + "\x00" + key.Secret)), key.LANAccess}
+	}
+	return grants
+}
+
+func newRouterAccessPolicy(allowPrivate bool) *routerAccessPolicy {
+	return &routerAccessPolicy{keys: make(map[string]routerKeyGrant), streams: make(map[*routerKeyStream]bool), allowPrivate: allowPrivate}
+}
+
+func (p *routerAccessPolicy) view(keys []KeyConfig) routerKeyView {
+	return routerKeyView{p, routerGrants(keys)}
+}
+
+func (p *routerAccessPolicy) update(config Config) {
+	var keys []KeyConfig
+	for _, key := range config.Keys {
+		keys = append(keys, key.KeyConfig)
+	}
+	for _, service := range config.Services {
+		keys = append(keys, service.Keys...)
+	}
+	next := routerGrants(keys)
+	var closeStreams []func()
+	p.mu.Lock()
+	for stream := range p.streams {
+		old := p.keys[stream.id]
+		grant, exists := next[stream.id]
+		if !exists || old.fingerprint != grant.fingerprint || (old.lan && !grant.lan) {
+			closeStreams = append(closeStreams, stream.close)
+			delete(p.streams, stream)
+		}
+	}
+	p.keys = next
+	p.mu.Unlock()
+	for _, closeStream := range closeStreams {
+		closeStream()
+	}
+}
+
+func (v routerKeyView) current(id string) (routerKeyGrant, bool) {
+	grant, ok := v.policy.keys[id]
+	expected, known := v.keys[id]
+	return grant, ok && known && expected.fingerprint == grant.fingerprint
+}
+
+func (v routerKeyView) validate(id string, ip net.IP) error {
+	v.policy.mu.Lock()
+	grant, ok := v.current(id)
+	v.policy.mu.Unlock()
+	if !ok {
+		return errors.New("access key was revoked")
+	}
+	if v.policy.allowPrivate || grant.lan {
+		return onet.RequireGlobalUnicastIP(ip)
+	}
+	return onet.RequirePublicIP(ip)
+}
+
+func (v routerKeyView) register(ctx context.Context, id string, conn transport.StreamConn) (context.Context, func(), error) {
+	v.policy.mu.Lock()
+	defer v.policy.mu.Unlock()
+	if _, ok := v.current(id); !ok {
+		return ctx, nil, errors.New("access key was revoked")
+	}
+	// Listener replacement keeps authorized streams; revocation cancels them explicitly.
+	ctx, cancel := context.WithCancel(context.WithoutCancel(ctx))
+	stream := &routerKeyStream{id: id, close: func() { cancel(); conn.Close() }}
+	v.policy.streams[stream] = true
+	return ctx, func() {
+		cancel()
+		v.policy.mu.Lock()
+		delete(v.policy.streams, stream)
+		v.policy.mu.Unlock()
+	}, nil
+}
+
+var routerReady = func() *os.File {
+	if os.Getenv("OUTLINE_ROUTER_READY") == "1" {
+		return os.NewFile(3, "outline-router-ready")
+	}
+	return nil
+}()
+
+func routerReloadResult(digest string, loadErr error) {
+	if routerReady == nil {
+		return
+	}
+	result := "reloaded"
+	if loadErr != nil {
+		result = "failed"
+	}
+	if _, err := fmt.Fprintf(routerReady, "%s %s\n", result, digest); err != nil {
+		os.Exit(1)
+	}
+}

+package main
+
+import (
+	"context"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestRouterPerKeyTargetPolicy(t *testing.T) {
+	keys := []KeyConfig{{ID: "ordinary", Secret: "ordinary"}, {ID: "owner", Secret: "owner", LANAccess: true}}
+	policy := newRouterAccessPolicy(false)
+	policy.update(Config{Services: []ServiceConfig{{Keys: keys}}})
+	validate := policy.view(keys).validate
+	for _, address := range []string{"10.0.0.127", "172.16.1.1", "192.168.2.1", "fd42::1", "::ffff:10.0.0.127"} {
+		for _, id := range []string{"ordinary", "unknown"} {
+			if validate(id, net.ParseIP(address)) == nil {
+				t.Fatalf("%s reached private target %s", id, address)
+			}
+		}
+		if err := validate("owner", net.ParseIP(address)); err != nil {
+			t.Fatal(address, err)
+		}
+	}
+	for _, id := range []string{"ordinary", "owner"} {
+		if err := validate(id, net.ParseIP("1.1.1.1")); err != nil {
+			t.Fatal(err)
+		}
+		for _, address := range []string{"127.0.0.1", "::1", "169.254.169.254", "fe80::1", "0.0.0.0", "224.0.0.1", "invalid"} {
+			if validate(id, net.ParseIP(address)) == nil {
+				t.Fatalf("accepted forbidden target %s", address)
+			}
+		}
+	}
+	config, err := readConfig([]byte(`{"services":[{"keys":[{"id":"old"},{"id":"owner","lan_access":true}]}]}`))
+	if err != nil || config.Services[0].Keys[0].LANAccess || !config.Services[0].Keys[1].LANAccess {
+		t.Fatal("LAN permissions did not decode or default to denied", err)
+	}
+}
+
+type routerPolicyStream struct{ net.Conn }
+
+func (c routerPolicyStream) CloseRead() error  { return c.Close() }
+func (c routerPolicyStream) CloseWrite() error { return c.Close() }
+
+func TestRouterRevocationClosesOnlyAffectedKeysAndRejectsStaleAuthentication(t *testing.T) {
+	keys := []KeyConfig{{ID: "owner", Secret: "owner", LANAccess: true}, {ID: "other", Secret: "other", LANAccess: true}}
+	policy := newRouterAccessPolicy(false)
+	config := Config{Services: []ServiceConfig{{Keys: keys}}}
+	policy.update(config)
+	view := policy.view(keys)
+	first, firstPeer := net.Pipe()
+	defer firstPeer.Close()
+	second, secondPeer := net.Pipe()
+	defer secondPeer.Close()
+	defer second.Close()
+	parent, cancelParent := context.WithCancel(context.Background())
+	one, releaseOne, err := view.register(parent, "owner", routerPolicyStream{first})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer releaseOne()
+	two, releaseTwo, err := view.register(parent, "other", routerPolicyStream{second})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer releaseTwo()
+	cancelParent()
+	if one.Err() != nil || two.Err() != nil {
+		t.Fatal("listener reload terminated authorized streams")
+	}
+	keys[0].LANAccess = false
+	policy.update(config)
+	if one.Err() == nil || two.Err() != nil {
+		t.Fatal("revocation did not isolate the affected key")
+	}
+	var data [1]byte
+	firstPeer.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := firstPeer.Read(data[:]); err != io.EOF {
+		t.Fatal("revoked stream stayed open", err)
+	}
+	if view.validate("owner", net.ParseIP("10.0.0.127")) == nil {
+		t.Fatal("old view retained LAN access")
+	}
+	keys[1].Secret = "replacement"
+	policy.update(config)
+	if two.Err() == nil {
+		t.Fatal("replaced credentials kept their active stream")
+	}
+	if view.validate("other", net.ParseIP("1.1.1.1")) == nil {
+		t.Fatal("old credentials survived replacement")
+	}
+	if _, _, err := view.register(context.Background(), "other", routerPolicyStream{second}); err == nil {
+		t.Fatal("stale authentication registered after revocation")
+	}
+	for _, bad := range [][]KeyConfig{{{ID: "same", Secret: "a"}, {ID: "same", Secret: "b"}}, {{ID: "one", Secret: "same"}, {ID: "two", Secret: "same"}}} {
+		if (&Config{Services: []ServiceConfig{{Keys: bad}}}).Validate() == nil {
+			t.Fatal("ambiguous key identities were accepted")
+		}
+	}
+}

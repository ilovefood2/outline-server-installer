+
+func TestRouterRevokedAuthenticationCannotReachTarget(t *testing.T) {
+	server, client := net.Pipe()
+	defer server.Close()
+	defer client.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	h := NewStreamHandler(func(c transport.StreamConn) (string, transport.StreamConn, *onet.ConnectionError) {
+		return "owner", c, nil
+	}, time.Minute)
+	h.SetAccessKeyStreamHandler(func(ctx context.Context, id string, conn transport.StreamConn) (context.Context, func(), error) {
+		return ctx, nil, errors.New("revoked")
+	})
+	done := make(chan struct{})
+	go func() { h.Handle(ctx, routerTestStream{server}, nil); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("revoked authentication was allowed to read a target")
+	}
+}
+
+func TestRouterUDPChecksKeyOnEveryPacket(t *testing.T) {
+	h := NewPacketHandler(time.Minute, nil, nil, nil).(*packetHandler)
+	allow := true
+	h.SetAccessKeyTargetIPValidator(func(id string, ip net.IP) error {
+		if id == "owner" && allow {
+			return onet.RequireGlobalUnicastIP(ip)
+		}
+		return onet.RequirePublicIP(ip)
+	})
+	packet := append([]byte(socks.ParseAddr("10.0.0.127:3389")), []byte("test")...)
+	if _, _, err := h.validatePacket(packet, "ordinary"); err == nil {
+		t.Fatal("untrusted key reached LAN")
+	}
+	if _, _, err := h.validatePacket(packet, "owner"); err != nil {
+		t.Fatal(err)
+	}
+	allow = false
+	if _, _, err := h.validatePacket(packet, "owner"); err == nil {
+		t.Fatal("revoked LAN permission stayed active")
+	}
+}
+
+func TestRouterAuthenticationFloodIsBounded(t *testing.T) {
+	for i := 0; i < cap(routerHandshakeSlots); i++ {
+		routerHandshakeSlots <- struct{}{}
+	}
+	defer func() {
+		for i := 0; i < cap(routerHandshakeSlots); i++ {
+			<-routerHandshakeSlots
+		}
+	}()
+	server, client := net.Pipe()
+	defer server.Close()
+	defer client.Close()
+	h := NewStreamHandler(func(c transport.StreamConn) (string, transport.StreamConn, *onet.ConnectionError) {
+		t.Error("full authentication pool accepted another connection")
+		return "", nil, onet.NewConnectionError("ERR_TEST", "test", nil)
+	}, time.Minute)
+	done := make(chan struct{})
+	go func() { h.Handle(context.Background(), routerTestStream{server}, nil); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("authentication flood was not rejected promptly")
+	}
+}

# Copy to outline.env and fill in after first install (values come from /opt/outline).
# Used only by docker-compose.yml — the main installer does not need this file.

SB_IMAGE=localhost/outline/shadowbox:stable
SHADOWBOX_DIR=/opt/outline

# Defaults used by this Raspberry Pi build
SB_ACCESS_KEY_PREFIX=POST%20
SB_ALLOW_PRIVATE_TARGETS=true

# From install output / access.txt — do not commit real values
SB_API_PORT=12345
SB_API_PREFIX=replace-with-secret-prefix

# Leave empty to disable shared metrics
SB_METRICS_URL=

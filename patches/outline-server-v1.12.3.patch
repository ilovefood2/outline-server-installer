diff --git a/outline_patch_tests/private_targets_test.go b/outline_patch_tests/private_targets_test.go
new file mode 100644
index 0000000..ebdd0d1
--- /dev/null
+++ b/outline_patch_tests/private_targets_test.go
@@ -0,0 +1,21 @@
+package outlinepatchtests
+
+import (
+	"net"
+	"testing"
+
+	onet "github.com/Jigsaw-Code/outline-ss-server/net"
+)
+
+func TestPrivateTargetPolicy(t *testing.T) {
+	privateIP := net.ParseIP("192.168.1.10")
+	if err := onet.RequirePublicIP(privateIP); err == nil {
+		t.Fatal("upstream public-only policy unexpectedly accepted a private IP")
+	}
+	if err := onet.RequireGlobalUnicastIP(privateIP); err != nil {
+		t.Fatalf("LAN policy rejected a private unicast IP: %v", err)
+	}
+	if err := onet.RequireGlobalUnicastIP(net.ParseIP("127.0.0.1")); err == nil {
+		t.Fatal("LAN policy must continue to reject loopback targets")
+	}
+}

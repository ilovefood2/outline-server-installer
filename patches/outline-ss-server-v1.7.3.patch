+// RequireGlobalUnicastIP returns an error if the destination IP cannot be
+// routed as ordinary unicast traffic. Unlike RequirePublicIP, RFC1918 and ULA
+// addresses are accepted so an explicitly configured server can reach its LAN.
+func RequireGlobalUnicastIP(ip net.IP) error {
+	if !ip.IsGlobalUnicast() {
+		return NewConnectionError("ERR_ADDRESS_INVALID", fmt.Sprintf("Address is not global unicast: %s", ip.String()), nil)
+	}
+	return nil
+}
